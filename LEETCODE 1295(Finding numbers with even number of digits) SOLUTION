class Solution {
    public int findNumbers(int[] nums) {
        int count = 0;
        for(int i = 0;i<nums.length;i++){
            if(digits(nums[i])){
                count++;
                
            }
        }
        return count;
        }
    
    public boolean digits(int arr){
        int finding = even(arr);
        if(finding % 2 == 0 ){
            return true;
        }
        else{
            return false;
        }
    }
    public int even(int arr){
        if(arr < 0){
            arr = arr*-1;
        }
        if(arr == 0){
            return 1;
        }
        return (int)(Math.log10(arr))+1;
        
    }
}
